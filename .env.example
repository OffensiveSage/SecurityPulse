# =============================================================================
# Security Pulse — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env. The .gitignore excludes it.
# In production, all secrets must come from an approved secrets manager.
# =============================================================================

# --- Application ---
APP_ENV=development
# Values: development | production
# CRITICAL: When APP_ENV=production, ALLOW_MOCK_AUTH must be false.

APP_NAME=security-pulse
APP_VERSION=0.0.1

# --- Mock authentication (development only) ---
ALLOW_MOCK_AUTH=true
# MUST be false in production. The API refuses to start if
# APP_ENV=production and ALLOW_MOCK_AUTH=true.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://security_pulse:changeme_local@localhost:5432/security_pulse
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# In production: use a secrets manager reference, not a literal password.

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# In production: use TLS (rediss://) and a secrets manager reference.

# --- OIDC / Identity provider ---
# These values must come from your approved corporate identity provider.
# See ARCHITECTURE.md § Governance decisions #2.
OIDC_ISSUER_URL=
# Example (Entra ID): https://login.microsoftonline.com/<tenant-id>/v2.0
# Do not set in development when using mock auth.

OIDC_CLIENT_ID=
# The OAuth2 client ID registered with your identity provider.

OIDC_CLIENT_SECRET=
# Required for confidential clients (admin portal server-side flow).
# Mobile uses PKCE and does not require a client secret.
# In production: use a secrets manager reference.

OIDC_AUDIENCE=
# The expected audience claim in the access token.

# --- API ---
API_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
# Used for signing any internal tokens. Generate with: openssl rand -hex 32
# In production: use a secrets manager reference.

API_CORS_ORIGINS=http://localhost:3000
# Comma-separated list of allowed CORS origins.

API_RATE_LIMIT_PER_MINUTE=60
# Requests per minute per IP on auth and submission endpoints.

# --- Worker ---
WORKER_CONCURRENCY=4

# --- Notifications ---
# Notification provider not yet confirmed (governance decision #12).
# Placeholder:
NOTIFICATION_PROVIDER=none
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# --- Logging ---
LOG_LEVEL=INFO
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# In production: INFO or WARNING. Never DEBUG in production (may log sensitive data).

LOG_FORMAT=json
# Values: json | text
# Use json in production for structured log aggregation.

# --- Secrets manager (production only) ---
# SECRETS_MANAGER_PROVIDER=
# SECRETS_MANAGER_REGION=
# SECRETS_MANAGER_PREFIX=security-pulse/

# --- Admin portal ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
